{
	"schemaVersion": 1,
	"id": "mineagent",
	"version": "${version}",
	"name": "MineAgent",
	"description": "Lets an AI play your character: give it a goal and it walks, mines, crafts, smelts and fights to reach it. Works with Claude, ChatGPT, DeepSeek, Gemini, Ollama and other OpenAI-compatible APIs.",
	"authors": [
		"Tenshii"
	],
	"contact": {
		"homepage": "https://github.com/CuteTenshii/MineAgent",
		"sources": "https://github.com/CuteTenshii/MineAgent",
		"issues": "https://github.com/CuteTenshii/MineAgent/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"moe.tenshii.mineagent.MineAgentClient"
		],
		"jei_mod_plugin": [
			"moe.tenshii.mineagent.compat.JeiRecipes"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		{
			"config": "mineagent.client.mixins.json",
			"environment": "client"
		}
	]
}
